# Sirve la interfaz y manda /api a la API. Un solo origen para el navegador,
# asi que no hay lios de CORS ni cookies que se pierden entre puertos.
:8080 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8000
	}

	# El material de aprendizaje: un sitio estatico que se monta en `/aprende` (fuera de
	# `/srv`, que esta de solo lectura: un montaje anidado dentro de otro de solo lectura no
	# se puede crear). `handle_path` quita el prefijo antes de servir, asi que las paginas
	# del sitio se enlazan entre si por su nombre y no por su ruta.
	#
	# **Y una direccion que no existe ya no enseña la portada.** El `try_files` acababa en
	# `/index.html`, asi que un enlace viejo -- un documento renombrado, un marcador -- daba
	# **200 con el temario**: quien lo pulsaba no podia saber que su enlace estaba roto.
	# Medido el 27 de septiembre de 2026 (`data/debug/cuatrocientos.py`). Ahora se contesta la
	# pagina que lo dice, con su **404**, que es lo que ademas entienden los buscadores y las
	# caches.
	handle_path /aprende/* {
		root * /aprende
		try_files {path} {path}/index.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# Las fotos de los productos las sirven las propias cadenas desde sus
		# CDN. No se copian: se enlazan. Por eso img-src admite https.
		#
		# **Y las fuentes de Google ya no estan permitidas**, porque no hay ninguna: la
		# interfaz vieja cargaba Archivo desde `fonts.googleapis.com` y eso se arreglo, pero
		# el permiso se quedo escrito aqui. Un `style-src`/`font-src` que admite un sitio que
		# nadie usa es una puerta abierta por costumbre, y el proyecto dice justo lo contrario
		# («nada de fuentes ni imagenes traidas de internet»). Medido el 27 de septiembre de
		# 2026: ni un `fonts.googleapis` en el codigo ni en lo servido, solo en dos documentos
		# que cuentan que se quito.
		#
		# `base-uri 'none'` y `form-action 'self'` son dos cierres que faltaban y que no
		# cambian nada de lo que hace la aplicacion: sin `<base>` (no hay ninguno) y con los
		# formularios que ya van todos por JavaScript al mismo origen.
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# no-referrer haria que algunos CDN rechazasen la imagen.
		Referrer-Policy strict-origin-when-cross-origin
		# *** LO QUE EL NAVEGADOR TARDA EN ENTERARSE DE QUE HAY VERSION NUEVA. ***
		# *Los trozos llevan hash en el nombre, asi que un trozo es inmutable: el mismo nombre es el
		# mismo contenido, para siempre.* *Pero `sw.js` y `index.html` **no** llevan hash.*
		#
		# *Sin esto, el navegador puede cachear **el propio service worker** y no ver la version nueva
		# **nunca**: la app se queda clavada en el armazon viejo. Es el fallo clasico de una PWA, y no
		# se nota en desarrollo porque ahi no hay cache de por medio.*
		#
		# *`immutable` en `/assets/*` es lo que hace que 30 trozos no se vuelvan a pedir nunca.*
		header /sw.js Cache-Control "no-cache, must-revalidate"
		header /index.html Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		-Server
	}

	# **La cara rota del material.** Un 404 dentro de `/aprende` se cuenta con la pagina que lo
	# dice, en vez de con la portada: antes el `try_files` acababa en `/index.html`, asi que un
	# enlace viejo -- un documento renombrado, un marcador -- daba **200 con el temario** y
	# quien lo pulsaba no podia saber que su enlace estaba roto (medido el 27 de septiembre de
	# 2026 con `data/debug/cuatrocientos.py`). Va aqui y no dentro del `handle_path` porque
	# `handle_errors` no es un manejador ordenado y ahi no se puede usar -- Caddy lo dice al
	# arrancar, y con el fichero mal el contenedor **no arranca**: se vio al hacerlo.
	handle_errors {
		@material path /aprende/*
		handle @material {
			# El `root` va aqui dentro: en el bloque de errores no hereda el de los `handle`,
			# y sin el `file_server` no encontraba el fichero y contestaba vacio -- medido.
			root * /aprende
			rewrite * /404.html
			file_server
		}
	}

	log {
		output stdout
		format console
	}
}
