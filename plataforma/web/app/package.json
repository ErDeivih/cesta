{
  "name": "cesta-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "La interfaz de Cesta, en Vite + React + TypeScript. Sustituye a web/app.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "vista-previa": "vite preview",
    "tipos": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:cocina": "node --test tests/cocina.test.mjs",
    "lint": "eslint src",
    "lint:hooks": "eslint src --rule '{\"react-hooks/rules-of-hooks\":\"error\"}'",
    "test:componentes": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
