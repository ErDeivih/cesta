# Copia esto a `.env` y cambia la contrasena. El fichero .env no se sube a git.

# La contrasena de PostgreSQL. Invéntate una larga: no la vas a escribir nunca.
CESTA_CLAVE_DB=cambia-esto-por-algo-largo-y-aleatorio

# Donde esta la carpeta data/ del proyecto, vista desde plataforma/.
CESTA_DATOS=../data

# En que interfaz escucha la web. Lo correcto es la IP que te da Tailscale
# (100.x.y.z), para que el servicio no se asome ni siquiera a tu wifi.
# Déjalo en 0.0.0.0 mientras pruebas.
CESTA_ESCUCHA=0.0.0.0

# Desde donde se permite llamar a la API.
CESTA_ORIGENES=http://localhost:8080,http://cesta:8080

CESTA_DIAS_SESION=30
